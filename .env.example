# ==========================================
# FRONTEND NEXT.JS ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local
# ==========================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Email SMTP Credentials (Nodemailer Gmail)
# Create a Google App Password from: https://myaccount.google.com/apppasswords
EMAIL_USER=your_mail
EMAIL_PASS=your_google_app_password
EMAIL_TO=your_mail
